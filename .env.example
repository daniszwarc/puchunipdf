# Backend-only secrets. Never exposed to the frontend.
NAN_API_KEY=
CHAT_MODEL=qwen3.6
EMBED_MODEL=qwen3-embedding
# none | low | medium | high. Reasoning tokens are spent from CHAT_MAX_TOKENS.
REASONING_EFFORT=none
CHAT_MAX_TOKENS=8000
POSTGRES_PASSWORD=change-me

# Traefik basicauth (production). Generate with: htpasswd -nb user pass
# Keep the single quotes: the hash contains '$'.
BASIC_AUTH_USERS='user:$apr1$replace$me'
