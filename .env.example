# Backend-only secrets. Never exposed to the frontend.
NAN_API_KEY=
CHAT_MODEL=qwen3.6
EMBED_MODEL=qwen3-embedding
# none | low | medium | high. Reasoning tokens are spent from CHAT_MAX_TOKENS.
REASONING_EFFORT=none
CHAT_MAX_TOKENS=8000

# OCR for scanned pages (pages with < 25 characters of text layer)
OCR_DPI=200
# Each OCR worker keeps about 100 MB resident.
OCR_WORKERS=1
OCR_MAX_PAGES=150
POSTGRES_PASSWORD=change-me

# Required, at least 32 chars; signs session cookies. Generate: openssl rand -hex 32
SECRET_KEY=
# Set to false only for plain-http local testing (Secure cookies need https)
COOKIE_SECURE=true

